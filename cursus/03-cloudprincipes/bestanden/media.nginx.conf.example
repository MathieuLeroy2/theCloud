# Plaats in sites-available/media en activeer met een link in sites-enabled.
# De opleiding levert media.crt en media.key voor het echte adres van deze VM.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/tls/media.crt;
    ssl_certificate_key /etc/nginx/tls/media.key;
    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
    }
}
