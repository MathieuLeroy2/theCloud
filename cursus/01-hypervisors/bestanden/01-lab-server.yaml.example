# Voorbeeld voor Ubuntu Server; geen configuratie voor Proxmox of Xubuntu.
# Pas de bestaande Netplan-definitie aan. Maak geen tweede definitie voor dezelfde kaart.
# Vervang enp6s18 en alle adressen door de bevestigde waarden uit je labkaart.
network:
  version: 2
  renderer: networkd
  ethernets:
    enp6s18:
      dhcp4: false
      addresses:
        - 192.168.77.100/24
      routes:
        - to: default
          via: 192.168.77.2
      nameservers:
        addresses:
          - 192.168.77.2
