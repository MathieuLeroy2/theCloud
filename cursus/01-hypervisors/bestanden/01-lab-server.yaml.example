# Alleen voor Ubuntu Server. Niet voor Proxmox of Xubuntu.
# Gebruik de adressen van je verslag als ze anders zijn.
# Zoek met ip -br address de echte kaartnaam en vervang hieronder enp6s18.
# Pas het bestaande bestand voor die kaart aan; maak geen tweede instelling erbij.
# Gebruik spaties om in te springen, geen tabs.
network:
  version: 2
  renderer: networkd
  ethernets:
    enp6s18:
      dhcp4: false
      addresses:
        - 192.168.77.100/24
      routes:
        - to: default
          via: 192.168.77.2
      nameservers:
        addresses:
          - 192.168.77.2
